@page "/productApis/create"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using InventoryHub.Client.Shared.Models

<h3>Create Product</h3>

<EditForm Model="@newProduct" OnValidSubmit="HandleValidSubmit" >
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Product Name</label>
            <InputText @bind-Value="newProduct.Name" class="form-control" />
            <ValidationMessage For="@(() => newProduct.Name)" class="text-danger" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">SKU</label>
            <InputText @bind-Value="newProduct.SKU" class="form-control" />
            <ValidationMessage For="@(() => newProduct.SKU)" class="text-danger" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Unit Price ($)</label>
            <InputNumber @bind-Value="newProduct.UnitPrice" class="form-control" />
            <ValidationMessage For="@(() => newProduct.UnitPrice)" class="text-danger" />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Stock Quantity</label>
            <InputNumber @bind-Value="newProduct.StockQuantity" class="form-control" />
            <ValidationMessage For="@(() => newProduct.StockQuantity)" class="text-danger" />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Reorder Level</label>
            <InputNumber @bind-Value="newProduct.ReorderLevel" class="form-control" />
            <ValidationMessage For="@(() => newProduct.ReorderLevel)" class="text-danger" />
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">Category ID</label>
        <InputNumber @bind-Value="newProduct.CategoryId" class="form-control" />
        <ValidationMessage For="@(() => newProduct.CategoryId)" class="text-danger" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Save Product</button>
</EditForm>
<AuthorizeView>
    <Authorized>
        <hr />
        <div class="px-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
            </svg> @context.User.Identity?.Name
        </div>
    </Authorized>
</AuthorizeView>
@code {
    private Product newProduct = new Product();

    private async Task HandleValidSubmit()
    {
        // Seamless HTTP POST to API
        var response = await Http.PostAsJsonAsync("/api/products", newProduct);
        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/productApis");
        }
    }
}