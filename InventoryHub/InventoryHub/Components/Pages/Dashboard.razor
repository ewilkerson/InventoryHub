@page "/dashboard"
@using InventoryHub.Services
@using InventoryHub.Shared.Models
@inject IInventoryReportingService InventoryReportingService
@inject NavigationManager NavigationManager

<h2 class="mb-4">Inventory Dashboard</h2>


<div class="row">
    <!-- Total Inventory Value "Chart" -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Inventory Value by Category</h5>
            </div>
            <div class="card-body">
@if (isLoading)
{
    <p><em>Loading chart data...</em></p>
} else @if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else if (inventoryValues != null)
{
                    var maxVal = inventoryValues.Max(v => v.TotalInventoryValue);
                    
                    @foreach (var item in inventoryValues)
                    {
                        var percentage = maxVal > 0 ? (item.TotalInventoryValue / maxVal) * 100 : 0;
                        
                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <strong>@item.CategoryName</strong>
                                <span>@item.TotalInventoryValue.ToString("C") (@item.TotalItemsInStock items)</span>
                            </div>
                            <div class="progress" style="height: 25px;">
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: @percentage.ToString("0")%;" 
                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Restock Alerts Table -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">Restock Alerts</h5>
            </div>
            <div class="card-body">
                @if (isLoading)
                {
                    <p><em>Loading alerts...</em></p>
                }
                else if (errorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }
                else if (restockAlerts == null || !restockAlerts.Any())
                {
                    <div class="alert alert-success">All product stock levels are healthy!</div>
                }
                else @if (restockAlerts != null)
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in restockAlerts)
                            {
                                <tr class="table-warning">
                                    <td>
                                        <strong>@alert.ProductName</strong><br />
                                        <small class="text-muted">@alert.SKU | @alert.CategoryName</small>
                                    </td>
                                    <td class="text-danger fw-bold">@alert.StockQuantity</td>
                                    <td>@alert.ReorderLevel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
<AuthorizeView>
    <Authorized>
        <hr />
        <div class="px-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
            </svg> @context.User.Identity?.Name
        </div>
    </Authorized>
</AuthorizeView>
@code {
    private IEnumerable<InventoryValueReportDto> inventoryValues;
    private IEnumerable<RestockReportDto> restockAlerts;
    private string? errorMessage;
    private bool isLoading = true;

    protected override void OnInitialized()
    {
        try
        {
            // Fetch both reports concurrently for better performance

            var valueTask = InventoryReportingService.GetInventoryValueByCategory().ToList();
            var alertsTask = InventoryReportingService.GetProductsToRestock().ToList();

            // Cast the object to dynamic to access underlying properties
            inventoryValues = valueTask.Select(v =>
            {
                dynamic dyn = v;
                return new InventoryValueReportDto
                {
                    CategoryName = (string)dyn.CategoryName,
                    TotalItemsInStock = (int)dyn.TotalItemsInStock,
                    TotalInventoryValue = (decimal)dyn.TotalInventoryValue
                };
            });

            // Since GetProductsToRestock returns IEnumerable<Product>,
            // 'a' is already strongly typed.
            restockAlerts = alertsTask.Select(a => 
            {
                dynamic dyn = a;

            return new RestockReportDto
                {
                    ProductName = (string)dyn.ProductName,
                    SKU = (string)dyn.SKU,
                    StockQuantity = (int)dyn.StockQuantity,
                    ReorderLevel = (int)dyn.ReorderLevel,
                    CategoryName = (string)dyn.Category?.Name ?? "Uncategorized"
                };
            });
        }
        catch (HttpRequestException ex)
        {
             if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                 NavigationManager.NavigateTo("/login");
             }
             else
             {
                errorMessage = $"Server error: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while loading the data. Please verify your connection.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }

    }
}