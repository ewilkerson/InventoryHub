@page "/product"
@using InventoryHub.Models
@using InventoryHub.Services
@inject IProductService ProductService
@inject NavigationManager NavigationManager

<h3>Product List</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.SKU</td>
                    <td>@product.UnitPrice.ToString("C")</td>
                    <td>@product.StockQuantity</td>
                </tr>
            }
        </tbody>
    </table>

}

@code {
    private IEnumerable<Product>? products;
    private string? errorMessage;
    private bool isLoading = true;


    protected override void OnInitialized()
    {
        try
        {

        // Fetches product data using the GetAllProducts method from ProductService.cs[cite: 3]
        products = ProductService.GetAllProducts();
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                errorMessage = $"Server error: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while loading the data. Please verify your connection.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }

    }
}