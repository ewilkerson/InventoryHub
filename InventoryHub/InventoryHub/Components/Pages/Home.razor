<h3>VaultCryptoService Example</h3>
<p>This service provides encryption and decryption functionality for securely storing sensitive data in the vault.</p>
<p>
	Original Text: @originalText<br />
	Master Password: @masterPassword
</p>
<p>Encrypted Text (Base64 Salt + IV + CipherText): @encryptedText</p>
<p>
	Decrypted Text: @decryptedText
</p>
<p>
	Match successful: @(originalText == decryptedText)
</p>
<AuthorizeView>
	<Authorized>
		<hr />
		<div class="px-3">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
				<path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
			</svg> @context.User.Identity?.Name
		</div>
	</Authorized>
</AuthorizeView>
@code {

	static string originalText = "A67B9012CDEF34567890123456789012";
	static string masterPassword = "MySecureMasterPassword!2026";

	// 2. Encrypt the data
	// This generates the salt, IV, and cipher text, returning them as a single Base64 string

	static string encryptedText = VaultCryptoService.Encrypt(originalText, masterPassword);
	// 3. Decrypt the data
	// This parses the salt and IV from the Base64 string to reconstruct the original text
	static string decryptedText = VaultCryptoService.Decrypt(encryptedText, masterPassword);

}
